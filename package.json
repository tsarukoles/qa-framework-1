{
  "name": "qa-framework-1",
  "private": true,
  "scripts": {
    "test": "cross-env APP_ENV=dev playwright test",
    "test:prod": "cross-env APP_ENV=prod playwright test",
    "test:list": "cross-env APP_ENV=dev playwright test --list",
    "test:safety": "tsx --test safety/target.test.ts safety/helpers.test.ts safety-tests/vault-log.test.mjs safety-tests/guard.test.mjs safety-tests/worklog.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.19.2",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.5",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "lint-staged": {
    "*.{ts,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  }
}
