{
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run typecheck)", "Bash(npm run test:safety)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Edit(.env*)"],
    "ask": ["Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/vault-sync.mjs --from-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/vault-sync.mjs --session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-preflight.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/stop-worklog.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/vault-sync.mjs --session-end"
          }
        ]
      }
    ]
  }
}
